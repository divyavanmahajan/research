            "compression": 0,
            "text": "{\"@odata.context\": \"https%3A%2F%2Fapi.FIELD_8187a691%2Fnews%2F%24metadata%23feed\", \"value\": [{\"nextPageUrl\": \"https://api.FIELD_8187a691:443/news/feed/me?$top=1&$skip=1&$filter=_t eq 'CompositeCard'&contentType=article,video,slideshow&query=topstories&queryType=myFeed&ocid=anaheim-ntp-bn&apikey=0QfOX3Vn51YCzitbLaRkTTBadtWpgTN8NZLW0C1SEM&responseSchema=CardView&market=sv-se&timeOut=10000&User=m-15B5A6F39157684E2D2DB1E490E169F9\", \"subCards\": [{\"id\": \"AA1XQTGd\", \"type\": \"article\", \"title\": \"USA terrorst\\u00e4mplar islamister i Sudan\", \"abstract\": \"USA klassar nu \\u00e4ven Muslimska br\\u00f6draskapet i Sudan som en terrororganisation. Det meddelar USA:s utrikesdepartement. USA anklagar \\u00e4ven den islamistiska grupperingen f\\u00f6r att f\\u00e5 st\\u00f6d fr\\u00e5n Iran. Beskedet kommer drygt tv\\u00e5 m\\u00e5nader efter det att USA terrorst\\u00e4mplat organisationens f\\u00f6rgreningar i Egypten, Libanon och Jordanien. Den sunnimuslimska religi\\u00f6sa och politiska r\\u00f6relsen bildades 1928 i Egypten och har sedan dess spridit sig till en rad l\\u00e4nder.\", \"readTimeMin\": 1, \"url\": \"https://www.FIELD_8187a691/sv-se/nyheter/utrikes/usa-terrorst\\u00e4mplar-islamister-i-sudan/ar-AA1XQTGd\", \"locale\": \"sv-se\", \"galleryItemCount\": 0, \"financeMetadata\": {\"stocks\": [], \"sentimentRatings\": [{\"topic\": \"wf_sentiment_positive\", \"score\": 1073}, {\"topic\": \"wf_sentiment_negative\", \"score\": 6939}, {\"topic\": \"wf_sentiment_neutral\", \"score\": 1987}], \"categories\": []}, \"publishedDateTime\": \"2026-03-09T18:59:23Z\", \"images\": [{\"width\": 1024, \"height\": 681, \"url\": \"https://th.bing.com/th?id=ORMS.ef3f89f4e353340f2d3ce66549a5ebde&pid=Wdp\", \"title\": \"USA:s utrikesminister Marco Rubio. Arkivbild.\", \"caption\": \"USA:s utrikesminister Marco Rubio. Arkivbild.\", \"focalRegion\": {\"x1\": 502, \"x2\": 711, \"y1\": 228, \"y2\": 437}, \"source\": \"msn\", \"colorSamples\": [{\"isDarkMode\": true, \"hexColor\": \"#164F60\"}, {\"isDarkMode\": false, \"hexColor\": \"#BADBE2\"}]}], \"provider\": {\"id\": \"AA28Nf\", \"name\": \"TT Nyhetsbyr\\u00e5n\", \"logoUrl\": \"https://img-s-msn-com.akamaized.net/tenant/amp/entityid/AA43KF3.img\", \"mainLogoUrl\": \"https://img-s-msn-com.akamaized.net/tenant/amp/entityid/AA43KF3.img\", \"profileId\": \"vid-g9kw6dnkhig3ay7er9vqqf973ech3p2xve9en5jwp003ycsy4svs\", \"lightThemeSVGLogo\": {\"width\": 0, \"height\": 0, \"url\": \"\"}, \"darkThemeSVGLogo\": {\"width\": 0, \"height\": 0, \"url\": \"\"}}, \"category\": \"nyheter\", \"reactionSummary\": {\"totalCount\": 0}, \"reactionStatus\": \"on\", \"commentStatus\": \"off\", \"relevanceScore\": 5005524.0, \"subscriptionProductType\": \"undefined\", \"feed\": {\"feedName\": \"news\"}, \"topics\": [], \"recoId\": \"9IY29iDNOdjuE6qrH-4AurKsAm\", \"source\": \"msn\", \"dedupeIds\": {\"NewsClusterV5HPHash\": [\"PHONE_15ef5db4\"], \"NewsClusterV6Hash\": [\"PHONE_c9a0939c\"], \"NewsClusterV7Hash\": [\"PHONE_2730cb95\"], \"ContentId\": [\"AA1XQTGd\"]}}], \"feed\": {}}]}"
