04\u0e2d\u0e42\u0e21\u0e42\u0e23\u0e2a\",kn:\"\u0e40\u0e0b\u0e19\u0e15\u0e4c\u0e04\u0e34\u0e15\u0e2a\u0e4c\u0e41\u0e25\u0e30\u0e40\u0e19\u0e27\u0e34\u0e2a\",kp:\"\u0e40\u0e01\u0e32\u0e2b\u0e25\u0e35\u0e40\u0e2b\u0e19\u0e37\u0e2d\",kr:\"\u0e40\u0e01\u0e32\u0e2b\u0e25\u0e35\u0e43\u0e15\u0e49\",kw:\"\u0e04\u0e39\u0e40\u0e27\u0e15\",ky:\"\u0e2b\u0e21\u0e39\u0e48\u0e40\u0e01\u0e32\u0e30\u0e40\u0e04\u0e22\u0e4c\u0e41\u0e21\u0e19\",kz:\"\u0e04\u0e32\u0e0b\u0e31\u0e04\u0e2a\u0e16\u0e32\u0e19\",la:\"\u0e25\u0e32\u0e27\",lb:\"\u0e40\u0e25\u0e1a\u0e32\u0e19\u0e2d\u0e19\",lc:\"\u0e40\u0e0b\u0e19\u0e15\u0e4c\u0e25\u0e39\u0e40\u0e0b\u0e35\u0e22\",li:\"\u0e25\u0e34\u0e01\u0e40\u0e15\u0e19\u0e2a\u0e44\u0e15\u0e19\u0e4c\",lk:\"\u0e28\u0e23\u0e35\u0e25\u0e31\u0e07\u0e01\u0e32\",lr:\"\u0e44\u0e25\u0e1a\u0e35\u0e40\u0e23\u0e35\u0e22\",ls:\"\u0e40\u0e25\u0e42\u0e0b\u0e42\u0e17\",lt:\"\u0e25\u0e34\u0e17\u0e31\u0e27\u0e40\u0e19\u0e35\u0e22\",lu:\"\u0e25\u0e31\u0e01\u0e40\u0e0b\u0e21\u0e40\u0e1a\u0e34\u0e23\u0e4c\u0e01\",lv:\"\u0e25\u0e31\u0e15\u0e40\u0e27\u0e35\u0e22\",ly:\"\u0e25\u0e34\u0e40\u0e1a\u0e35\u0e22\",ma:\"\u0e42\u0e21\u0e23\u0e47\u0e2d\u0e01\u0e42\u0e01\",mc:\"\u0e42\u0e21\u0e19\u0e32\u0e42\u0e01\",md:\"\u0e21\u0e2d\u0e25\u0e42\u0e14\u0e27\u0e32\",me:\"\u0e21\u0e2d\u0e19\u0e40\u0e15\u0e40\u0e19\u0e42\u0e01\u0e23\",mf:\"\u0e40\u0e0b\u0e19\u0e15\u0e4c\u0e21\u0e32\u0e23\u0e4c\u0e15\u0e34\u0e19\",mg:\"\u0e21\u0e32\u0e14\u0e32\u0e01\u0e31\u0e2a\u0e01\u0e32\u0e23\u0e4c\",mh:\"\u0e2b\u0e21\u0e39\u0e48\u0e40\u0e01\u0e32\u0e30\u0e21\u0e32\u0e23\u0e4c\u0e41\u0e0a\u0e25\u0e25\u0e4c\",mk:\"\u0e21\u0e32\u0e0b\u0e34\u0e42\u0e14\u0e40\u0e19\u0e35\u0e22\u0e40\u0e2b\u0e19\u0e37\u0e2d\",ml:\"\u0e21\u0e32\u0e25\u0e35\",mm:\"\u0e40\u0e21\u0e35\u0e22\u0e19\u0e21\u0e32\u0e23\u0e4c (\u0e1e\u0e21\u0e48\u0e32)\",mn:\"\u0e21\u0e2d\u0e07\u0e42\u0e01\u0e40\u0e25\u0e35\u0e22\",mo:\"\u0e40\u0e02\u0e15\u0e1b\u0e01\u0e04\u0e23\u0e2d\u0e07\u0e1e\u0e34\u0e40\u0e28\u0e29\u0e21\u0e32\u0e40\u0e01\u0e4a\u0e32\u0e4