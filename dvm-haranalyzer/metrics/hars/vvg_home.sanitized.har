vo.com/is/image/\" data-cmp-dmname=\"VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_VolvoBuses_2025_Original file\" data-cmp-filereference=\"/content/dam/volvo-group/markets/master/about-us/strategy/7800_Electric_Front-view_0452_VolvoBuses_2025_Original file.tif\" data-asset=\"/content/dam/volvo-group/markets/master/about-us/strategy/7800_Electric_Front-view_0452_VolvoBuses_2025_Original file.tif\" data-title=\"A Volvo bus\" data-cmp-hook-image=\"imageV3\" class=\"cmp-image asset \" id=\"media-3a5fbd5ddd\" itemscope itemtype=\"http://schema.org/ImageObject\">\n                    <div class=\"asset__item\">\n                        \n                            \n                            \n    <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_VolvoBuses_2025_Original%20file?qlt=82&ts=1772194565222&dpr=off\" srcset=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_VolvoBuses_2025_Original%20file?qlt=82&amp;wid=128&amp;ts=1772194565222&amp;dpr=off&amp;fit=constrain 128w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_VolvoBuses_2025_Original%20file?qlt=82&amp;wid=256&amp;ts=1772194565222&amp;dpr=off&amp;fit=constrain 256w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_VolvoBuses_2025_Original%20file?qlt=82&amp;wid=512&amp;ts=1772194565222&amp;dpr=off&amp;fit=constrain 512w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_VolvoBuses_2025_Original%20file?qlt=82&amp;wid=768&amp;ts=1772194565222&amp;dpr=off&amp;fit=constrain 768w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_VolvoBuses_2025_Original%20file?qlt=82&amp;wid=1024&amp;ts=1772194565222&amp;dpr=off&amp;fit=constrain 1024w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/7800_Electric_Front-view_0452_Vol