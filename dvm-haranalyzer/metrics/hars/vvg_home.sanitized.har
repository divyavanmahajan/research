     <div data-nc=\"Image\" data-nc-params-Image='{\n                \"assetUrl\": \"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Fuel-cell-electric-hydrogen-truck_Original%20file?qlt=82&amp;ts=1772194565249&amp;dpr=off\",\n                \"assetPath\": \"VolvoInformationTechnologyAB/Fuel-cell-electric-hydrogen-truck_Original file\",\n                \"imageServer\": \"https://assets.volvo.com/is/image/\",\n                \"isZoom\": false,\n                \"assetId\": \"media-ce851a2c4b\"\n            }' class=\" asset__wrapper\">\n            \n            \n                <div data-cmp-is=\"image\" data-cmp-lazythreshold=\"0\" data-cmp-src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Fuel-cell-electric-hydrogen-truck_Original%20file?qlt=82&amp;wid=%7B.width%7D&amp;ts=1772194565249&amp;dpr=off&amp;fit=constrain\" data-cmp-widths=\"128,256,512,768,1024,1440,1920,2560,3440,3840\" data-cmp-dmimage data-cmp-dmserver=\"https://assets.volvo.com/is/image/\" data-cmp-dmname=\"VolvoInformationTechnologyAB/Fuel-cell-electric-hydrogen-truck_Original file\" data-cmp-filereference=\"/content/dam/volvo-group/markets/master/about-us/strategy/Fuel-cell-electric-hydrogen-truck_Original file.jpg\" data-asset=\"/content/dam/volvo-group/markets/master/about-us/strategy/Fuel-cell-electric-hydrogen-truck_Original file.jpg\" data-title=\"Volvo FH Aero\" data-cmp-hook-image=\"imageV3\" class=\"cmp-image asset \" id=\"media-ce851a2c4b\" itemscope itemtype=\"http://schema.org/ImageObject\">\n                    <div class=\"asset__item\">\n                        \n                            \n                            \n    <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Fuel-cell-electric-hydrogen-truck_Original%20file?qlt=82&ts=1772194565249&dpr=off\" srcset=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Fuel-cell-electric-hydrogen-truck_Original%20file?qlt=82&amp;wid=128&amp;ts=1772194565249&amp;dp