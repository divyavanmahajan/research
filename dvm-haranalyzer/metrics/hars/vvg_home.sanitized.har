" id=\"media-0aed592ec4\" itemscope itemtype=\"http://schema.org/ImageObject\">\n                    <div class=\"asset__item\">\n                        \n                            \n                            \n    <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&ts=1772194565468&dpr=off\" srcset=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=128&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 128w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=256&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 256w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=512&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 512w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=768&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 768w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=1024&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 1024w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=1440&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 1440w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=1920&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 1920w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=2560&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 2560w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=3440&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 3440w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/p042828?qlt=82&amp;wid=3840&amp;ts=1772194565468&amp;dpr=off&amp;fit=constrain 3840w\" class=\"cmp-image__image asset__image\" itemprop=\"contentUrl\" alt id=\"image-media-0aed592ec4\"/>\n\n                            \n                            \n                            \n                        \n                    </div>\n                </div>\n            \n            \n        </div>\n    \n    \n    \n\n            \n            <vcdk-theme-provider class=\"vcdk-theme-provider--mode-fixed\" data-vcdk-mode=\"dark\" themeid=\"volvo-dark\">\n                <div class=\"media__itemControls\" hidden>\n                    \n                </div>\n            </vcdk-theme-provider>\n        </div>\n        \n    </div>\n\n\n\n    \n\n</div>\n\n\n        </div>\n\n    </div>\n</section>\n\n</div>\n<div class=\"columncontrol margin-top--none margin-bottom--none\">\n    \n    \n\n\n\n    \n    \n\n\n<section data-nc=\"ColumnControl\" class=\"columncontrol__base\">\n    <div class=\"columncontrol__grid aem-Grid aem-Grid--12 aem-Grid--default--12 row-height--none\">\n        \n        <div class=\"columncontrol__column aem-GridColumn aem-GridColumn--phone--12 aem-GridColumn--tablet--6 aem-GridColumn--default--6\">\n            \n            \n\n        </div>\n<div class=\"columncontrol__column aem-GridColumn aem-GridColumn--phone--12 aem-GridColumn--tablet--6 aem-GridColumn--default--6\">\n            \n            \n\n        </div>\n\n    </div>\n</section>\n\n</div>\n\n        \n    </div>\n\n</div></div>\n<div class=\"text margin-top--single margin-bottom--single aem-GridColumn--default--none aem-GridColumn aem-GridColumn--default--6 aem-GridColumn--offset--default--3\">\n\n    \n    \n    \n    \n\n\n\n\n  <div class=\"text__container\" data-nc=\"Text\">\n      <h2 style=\"\ttext-align: center;\n\">Our success drivers</h2>\r\n<p style=\"\ttext-align: center;\n\">We combine a people-centric approach with operational excellence, guided by our core values: trust, passion, customer success, change and performance.</p>\r\n\n  </div>\n  \n    \n\n</div>\n<div class=\"container__base container--fullWidth container--padding-none margin-top--single margin-bottom--single overlay--none vcdk-mode-dark container--background-bg-base aem-GridColumn aem-GridColumn--default--12\"><div data-nc=\"Container\" data-nc-params-Container='{\n          \"parallax\": true,\n          \"legacyBg\": \"#141414\",\n          \"hasBgImage\": false\n     }' class=\"container__module \">\n     \n          \n    \n\n\n\n          \n    \n\n\n\n     \n     \n     \n     \n     \n     \n    \n    <div id=\"container-1b1c34b0fd\" class=\"container__main cmp-container  \">\n        \n        <div class=\"columncontrol mobile-horizontal-scroll margin-top--none margin-bottom--none\">\n    \n    \n\n\n\n    \n    \n\n\n<section data-nc=\"ColumnControl\" class=\"columncontrol__base\">\n    <div class=\"columncontrol__grid aem-Grid aem-Grid--12 aem-Grid--default--12 row-height--none\">\n        \n        <div class=\"columncontrol__column aem-GridColumn aem-GridColumn--phone--12 aem-GridColumn--tablet--6 aem-GridColumn--default--4\">\n            \n            <div class=\"container__base vcdk-mode-dark section\"><div data-nc=\"Container\" data-nc-params-Container='{\n          \"parallax\": false,\n          \"legacyBg\": \"\",\n          \"hasBgImage\": false\n     }' class=\"container__module \">\n     \n          \n    \n\n\n\n          \n    \n\n\n\n     \n     \n     \n     \n     \n     \n    \n    <div id=\"container-90871d14e2\" class=\"container__main cmp-container  \">\n        \n        <div class=\"text margin-top--single margin-bottom--single\">\n\n    \n    \n    \n    \n\n\n\n\n  <div class=\"text__container\" data-nc=\"Text\">\n      <h3 style=\"\ttext-align: left;\n\">Commitment to people</h3>\r\n<p>Making our customers succeed is at the heart of everything we do, today and tomorrow\u200b.</p>\r\n<p>Our people come first, we create an environment where everyone can thrive and unleash their full potential\u200b.</p>\r\n<p>We value diverse perspectives, fostering inclusiveness and collaboration\u200b to bring out the best in everyone.\u00a0</p>\r\n<p>We do business responsibly, always staying true to our code of conduct\u200b.</p>\r\n\n  </div>\n  \n    \n\n</div>\n\n        \n    </div>\n\n</div></div>\n<div class=\"container__base vcdk-mode-dark section\"><div data-nc=\"Container\" data-nc-params-Container='{\n          \"parallax\": false,\n          \"legacyBg\": \"\",\n          \"hasBgImage\": false\n     }' class=\"container__module \">\n     \n          \n    \n\n\n\n          \n    \n\n\n\n     \n     \n     \n     \n     \n     \n    \n    <div id=\"container-41baaf6099\" class=\"container__main cmp-container  container__main--empty\">\n        \n        \n        \n    </div>\n\n</div></div>\n\n\n        </div>\n<div class=\"columncontrol__column aem-GridColumn aem-GridColumn--phone--12 aem-GridColumn--tablet--6 aem-GridColumn--default--4\">\n            \n            <div class=\"media image media--contentWidth margin-top--single margin-bottom--single section\">\n\n\n\n    \n        \n    \n\n\n\n        \n    \n\n\n\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    <div data-nc=\"Media\" data-nc-params-Media='{\n            \"isLightboxActive\": false,\n            \"isLightboxAssetConfigured\": false,\n            \"isLightboxAssetImage\": false,\n            \"isLightboxAssetVideo\": false,\n            \"isLightboxAssetLoopVideo\": false,\n            \"isMainItemImage\": true,\n            \"isMainItemVideo\": false,\n            \"isMainItemLoopVideo\": false,\n            \"isMainItemDecorative\": false\n        }' class=\"media__base\">\n        <div class=\"media__item media__item--default \">\n            \n    \n    \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n    \n    \n    <script type=\"text/javascript\" src=\"https://assets.volvo.com/s7viewers/html5/js/ZoomViewer.js\" defer></script>\n    \n    \n    \n    \n    \n    \n    \n\n\n\n    \n    \n    \n    \n    \n\n\n\n\n        \n        <div data-nc=\"Image\" data-nc-params-Image='{\n                \"assetUrl\": \"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;ts=1772194565560&amp;dpr=off\",\n                \"assetPath\": \"VolvoInformationTechnologyAB/loveandwork\",\n                \"imageServer\": \"https://assets.volvo.com/is/image/\",\n                \"isZoom\": false,\n                \"assetId\": \"media-441a5b131a\"\n            }' class=\" asset__wrapper\">\n            \n            \n                <div data-cmp-is=\"image\" data-cmp-lazythreshold=\"0\" data-cmp-src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=%7B.width%7D&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain\" data-cmp-widths=\"128,256,512,768,1024,1440,1920,2560,3440,3840\" data-cmp-dmimage data-cmp-dmserver=\"https://assets.volvo.com/is/image/\" data-cmp-dmname=\"VolvoInformationTechnologyAB/loveandwork\" data-cmp-filereference=\"/content/dam/volvo-group/markets/master/about-us/strategy/loveandwork.jpg\" data-asset=\"/content/dam/volvo-group/markets/master/about-us/strategy/loveandwork.jpg\" data-cmp-hook-image=\"imageV3\" class=\"cmp-image asset \" id=\"media-441a5b131a\" itemscope itemtype=\"http://schema.org/ImageObject\">\n                    <div class=\"asset__item\">\n                        \n                            \n                            \n    <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&ts=1772194565560&dpr=off\" srcset=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=128&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 128w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=256&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 256w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=512&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 512w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=768&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 768w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=1024&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 1024w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=1440&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 1440w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=1920&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 1920w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=2560&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 2560w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=3440&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 3440w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/loveandwork?qlt=82&amp;wid=3840&amp;ts=1772194565560&amp;dpr=off&amp;fit=constrain 3840w\" class=\"cmp-image__image asset__image\" itemprop=\"contentUrl\" alt id=\"image-media-441a5b131a\"/>\n\n                            \n                            \n                            \n                        \n                    </div>\n                </div>\n            \n            \n        </div>\n    \n    \n    \n\n            \n            <vcdk-theme-provider class=\"vcdk-theme-provider--mode-fixed\" data-vcdk-mode=\"dark\" themeid=\"volvo-dark\">\n                <div class=\"media__itemControls\" hidden>\n                    \n                </div>\n            </vcdk-theme-provider>\n        </div>\n        \n    </div>\n\n\n\n    \n\n</div>\n\n\n        </div>\n<div class=\"columncontrol__column aem-GridColumn aem-GridColumn--phone--12 aem-GridColumn--tablet--12 aem-GridColumn--default--4\">\n            \n            <div class=\"container__base vcdk-mode-dark section\"><div data-nc=\"Container\" data-nc-params-Container='{\n          \"parallax\": false,\n          \"legacyBg\": \"\",\n          \"hasBgImage\": false\n     }' class=\"container__module \">\n     \n          \n    \n\n\n\n          \n    \n\n\n\n     \n     \n     \n     \n     \n     \n    \n    <div id=\"container-bd4bcf95ba\" class=\"container__main cmp-container  \">\n        \n        <div class=\"text margin-top--single margin-bottom--single\">\n\n    \n    \n    \n    \n\n\n\n\n  <div class=\"text__container\" data-nc=\"Text\">\n      <h4 style=\"\ttext-align: left;\n\">Operational excellence</h4>\r\n<p>We take accountability with clear leadership and profit and loss responsibility in every business area.</p>\r\n<p>Our global functions leverage leading expertise to drive innovation, efficiency, and lasting value creation.</p>\r\n<p>We drive customer value, product performance and internal efficiency through digital transformation, automation and AI.\u00a0</p>\r\n<p>We foster value-driven innovation through close collaboration with our partners.</p>\r\n\n  </div>\n  \n    \n\n</div>\n\n        \n    </div>\n\n</div></div>\n<div class=\"container__base vcdk-mode-dark section\"><div data-nc=\"Container\" data-nc-params-Container='{\n          \"parallax\": false,\n          \"legacyBg\": \"\",\n          \"hasBgImage\": false\n     }' class=\"container__module \">\n     \n          \n    \n\n\n\n          \n    \n\n\n\n     \n     \n     \n     \n     \n     \n    \n    <div id=\"container-7db402d814\" class=\"container__main cmp-container  container__main--empty\">\n        \n        \n        \n    </div>\n\n</div></div>\n\n\n        </div>\n\n    </div>\n</section>\n\n</div>\n\n        \n    </div>\n\n</div></div>\n<div class=\"text margin-top--single margin-bottom--single aem-GridColumn aem-GridColumn--default--12\">\n\n    \n    \n    \n    \n\n\n\n\n  <div class=\"text__container\" data-nc=\"Text\">\n      <h2>Group financial targets</h2>\r\n\n  </div>\n  \n    \n\n</div>\n<div class=\"media image media--contentWidth margin-top--single margin-bottom--single aem-GridColumn aem-GridColumn--default--12\">\n\n\n\n    \n        \n    \n\n\n\n        \n    \n\n\n\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    <div data-nc=\"Media\" data-nc-params-Media='{\n            \"isLightboxActive\": false,\n            \"isLightboxAssetConfigured\": false,\n            \"isLightboxAssetImage\": false,\n            \"isLightboxAssetVideo\": false,\n            \"isLightboxAssetLoopVideo\": false,\n            \"isMainItemImage\": true,\n            \"isMainItemVideo\": false,\n            \"isMainItemLoopVideo\": false,\n            \"isMainItemDecorative\": false\n        }' class=\"media__base\">\n        <div class=\"media__item media__item--default \">\n            \n    \n    \n        \n        \n        \n        \n        \n        \n        \n        \n        \n        \n    \n    \n    <script type=\"text/javascript\" src=\"https://assets.volvo.com/s7viewers/html5/js/ZoomViewer.js\" defer></script>\n    \n    \n    \n    \n    \n    \n    \n\n\n\n    \n    \n    \n    \n    \n\n\n\n\n        \n        <div data-nc=\"Image\" data-nc-params-Image='{\n                \"assetUrl\": \"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;ts=1772194565585&amp;dpr=off\",\n                \"assetPath\": \"VolvoInformationTechnologyAB/Outcome-2025\",\n                \"imageServer\": \"https://assets.volvo.com/is/image/\",\n                \"isZoom\": false,\n                \"assetId\": \"media-8accc0735c\"\n            }' class=\" asset__wrapper\">\n            \n            \n                <div data-cmp-is=\"image\" data-cmp-lazythreshold=\"0\" data-cmp-src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=%7B.width%7D&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha\" data-cmp-widths=\"128,256,512,768,1024,1440,1920,2560,3440,3840\" data-cmp-dmimage data-cmp-dmserver=\"https://assets.volvo.com/is/image/\" data-cmp-dmname=\"VolvoInformationTechnologyAB/Outcome-2025\" data-cmp-filereference=\"/content/dam/volvo-group/markets/global/classic/investors/financial-targets/Outcome-2025.png\" data-asset=\"/content/dam/volvo-group/markets/global/classic/investors/financial-targets/Outcome-2025.png\" data-title=\"2025\" data-cmp-hook-image=\"imageV3\" class=\"cmp-image asset \" id=\"media-8accc0735c\" itemscope itemtype=\"http://schema.org/ImageObject\">\n                    <div class=\"asset__item\">\n                        \n                            \n                            \n    <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&ts=1772194565585&dpr=off\" srcset=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=128&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 128w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=256&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 256w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=512&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 512w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=768&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 768w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=1024&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 1024w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=1440&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 1440w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=1920&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 1920w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=2560&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 2560w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=3440&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 3440w, https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Outcome-2025?qlt=82&amp;wid=3840&amp;ts=1772194565585&amp;dpr=off&amp;fit=constrain&amp;fmt=png-alpha 3840w\" class=\"cmp-image__image asset__image\" itemprop=\"contentUrl\" alt=\"2025\" id=\"image-media-8accc0735c\"/>\n\n                            \n                            \n                            \n                        \n                    </div>\n                </div>\n            \n            \n        </div>\n    \n    \n    \n\n            \n            <vcdk-theme-provider class=\"vcdk-theme-provider--mode-fixed\" data-vcdk-mode=\"dark\" themeid=\"volvo-dark\">\n                <div class=\"media__itemControls\" hidden>\n                    \n                </div>\n            </vcdk-theme-provider>\n        </div>\n        \n    </div>\n\n\n\n    \n\n</div>\n<div class=\"text margin-top--single margin-bottom--single aem-GridColumn--default--none aem-GridColumn aem-GridColumn--default--8 aem-GridColumn--offset--default--2\">\n\n    \n    \n    \n    \n\n\n\n\n  <div class=\"text__container\" data-nc=\"Text\">\n      <h3>Download the 2025 Annual Report</h3>\r\n\n  </div>\n  \n    \n\n</div>\n<div class=\"button button--secondary margin-top--single margin-bottom--single aem-GridColumn aem-GridColumn--default--12\">\n\n\n    \n    \n<script src=\"/clientlibs-edge/production/20260304104855/shared/components/content/button.js\" defer></script>\n\n\n\n<div data-nc=\"Button\" data-nc-params-Button='{\n          \"analyticsData\": {\n               \"displayText\": \"Download the Volvo Group Annual Report 2025 (PDF, 10 MB)\",\n               \"href\": \"/content/dam/volvo-group/markets/master/events/2026/volvo-group%E2%80%93annual-report-2025.pdf\"\n          }\n     }'>\n    \n    \n    \n    \n    \n    <div class=\"button__base \">\n        <vcdk-button variant=\"secondary\" target=\"_blank\" size=\"large\" iconend=\"import\" href=\"/content/dam/volvo-group/markets/master/events/2026/volvo-group%E2%80%93annual-report-2025.pdf\">\n            Download the Volvo Group Annual Report 2025 (PDF, 10 MB)\n        </vcdk-button>\n    </div>\n\n</div>\n\n    \n\n</div>\n<div class=\"text margin-top--single margin-bottom--single aem-GridColumn aem-GridColumn--default--12\">\n\n    \n    \n    \n    \n\n\n\n\n  <div class=\"text__container\" data-nc=\"Text\">\n      <h2>Shaping the future of transport</h2>\r\n\n  </div>\n  \n    \n\n</div>\n<div class=\"text margin-top--single margin-bottom--single aem-GridColumn--default--none aem-GridColumn aem-GridColumn--default--8 aem-GridColumn--offset--default--2\">\n\n    \n    \n    \n    \n\n\n\n\n  <div class=\"text__container\" data-nc=\"Text\">\n      <p style=\"\ttext-align: center;\n\">Progress relies on continuous innovation and the best application of the latest technologies. At Volvo Group we approach things with an open and practical mindset. We believe that with thorough research and the right partners, we can create and scale transport, mobility and infrastructure solutions that will make a difference in our world.</p>\r\n<p style=\"\ttext-align: center;\n\">\u00a0</p>\r\n<p style=\"\ttext-align: center;\n\">Read some recent examples of how we are shaping the world we want to live in. Together.</p>\r\n\n  </div>\n  \n    \n\n</div>\n<div class=\"teaserlist list teaserlistLayout-cols--4 teaser--layout-top mobile-horizontal-scroll aem-GridColumn aem-GridColumn--default--12\">\n    \n    \n<link rel=\"stylesheet\" href=\"/clientlibs-edge/production/20260304104855/shared/components/content/teaserlist.css\" type=\"text/css\"><script src=\"/clientlibs-edge/production/20260304104855/shared/components/content/teaserlist.js\" defer></script>\n\n\n    \n    \n    \n\n    \n    \n        <link rel=\"stylesheet\" href=\"/clientlibs-edge/production/20260304104855/volvo-group/publish/components/content/teaserlist.css\" type=\"text/css\">\n    \n\n    \n    \n\n\n\n\n    \n    \n    \n    \n    \n        <span class=\"teaserlist__title--group t-caption-2\">Latest Press Release</span>\n        <h3 class=\"teaserlist__title\">Latest Press Release</h3>\n        <ul data-nc=\"TeaserList\" class=\"teaserlist__list teaserlist--layout-top\">\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/carbon-smart-factory.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/6-18?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Sk\u00f6vde foundry\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        5 mins.\n                    </span>\n                    <span class=\"article__time--mobile\">\n                        \n                        5 mins.\n                    </span>\n                </div>\n            </div>\n            <h3 class=\"cmp-teaser__title article__title\">Setting the standard for industrial foundries</h3>\n            <div class=\"cmp-teaser__description\">Decarbonizing heavy industry is a key element in the transition to a net-zero world, and Volvo Group is committed to making a difference along the entire value chain.</div>\n        </div>\n    </div>\n\n\n                        \n                    </a>\n                </li>\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/charging-ahead.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Milence-1-1?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Milence charging station\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        4 mins.\n                    </span>\n                    <span class=\"article__time--mobile\">\n                        \n                        4 mins.\n                    </span>\n                </div>\n            </div>\n            <h3 class=\"cmp-teaser__title article__title\">Charging ahead with Milence</h3>\n            <div class=\"cmp-teaser__description\">One of the key elements necessary to increase the adoption of zero emission vehicles in the transport, mobility, and infrastructure sectors is the availability of sufficient charging infrastructure. </div>\n        </div>\n    </div>\n\n\n                        \n                    </a>\n                </li>\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/thermal-management-is-cool.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/T2022_78462_Original%20file?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Electric Volvo Truck\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        4 mins.\n                    </span>\n                    <span class=\"article__time--mobile\">\n                        \n                        4 mins.\n                    </span>\n                </div>\n            </div>\n            <h3 class=\"cmp-teaser__title article__title\">Thermal management is cool </h3>\n            <div class=\"cmp-teaser__description\">An often overlooked, yet vital element of battery management system (BMS) design, is the thermal management system. </div>\n        </div>\n    </div>\n\n\n                        \n                    </a>\n                </li>\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/battery-management-systems.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/T2005_1822?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Battery management systems\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        5 mins.\n                    </span>\n                    <span class=\"article__time--mobile\">\n                        \n                        5 mins.\n                    </span>\n                </div>\n            </div>\n            <h3 class=\"cmp-teaser__title article__title\">Battery management systems: taking huge leaps forward </h3>\n            <div class=\"cmp-teaser__description\">Research and investment in battery management systems (BMS) is continuing at pace here at Volvo Group, enabling sustainable transportation to make a real differnence on our roads.</div>\n        </div>\n    </div>\n\n\n                        \n                    </a>\n                </li>\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/powering-businesses-with-energy-solutions.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/VE_Logistic%20-%20kopia%202?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Volvo Energy\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        3 mins.\n                    </span>\n                    <span class=\"article__time--mobile\">\n                        \n                        3 mins.\n                    </span>\n                </div>\n            </div>\n            <h3 class=\"cmp-teaser__title article__title\">Powering businesses with energy solutions </h3>\n            <div class=\"cmp-teaser__description\">Smart energy solutions, designed to optimize grid output, provide off-grid storage and emergency back-ups, are redefining how we view, store and utilize energy. </div>\n        </div>\n    </div>\n\n\n                        \n                    </a>\n                </li>\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/cespira.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Cespira-1?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Cespira\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        4 mins.\n                    </span>\n                    <span class=\"article__time--mobile\">\n                        \n                        4 mins.\n                    </span>\n                </div>\n            </div>\n            <h3 class=\"cmp-teaser__title article__title\">Low-carbon transportation is driving change </h3>\n            <div class=\"cmp-teaser__description\">Emission reduction continues to play a vital role in product and service development across the transportation industry. </div>\n        </div>\n    </div>\n\n\n                        \n                    </a>\n                </li>\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/optimizing-transport-logistics.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/logivity_genre%20green%20woman?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Logivity\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        4 mins.\n                    </span>\n                    <span class=\"article__time--mobile\">\n                        \n                        4 mins.\n                    </span>\n                </div>\n            </div>\n            <h3 class=\"cmp-teaser__title article__title\">Optimizing transport logistics </h3>\n            <div class=\"cmp-teaser__description\">Logivity, a Volvo Group company, is reimagining transport logistics by streamlining processes and reducing both costs and emissions.</div>\n        </div>\n    </div>\n\n\n                        \n                    </a>\n                </li>\n            \n                <li class=\"cmp-teaser__item\">\n                    <a class=\"cmp-teaser__link\" href=\"https://www.volvogroup.com/en/sustainable-transportation/sustainable-solutions/Shaping-the-future-of-transport/partnerships-that-make-a-difference.html\" target=\"_self\">\n                        \n    \n    \n    \n    \n\n    \n    \n\n    \n    \n        \n    \n\n\n\n    \n\n\n\n    <div class=\"cmp-teaser\">\n        <div class=\"cmp-teaser__image\">\n            <div class=\"cmp-image\" itemtype=\"http://schema.org/ImageObject\" itemscope>\n                \n                 <img src=\"https://assets.volvo.com/is/image/VolvoInformationTechnologyAB/Next%20generation%20of%20the%20highly%20efficient%20fuel%20cell%20system%20from%20cellcentric?size=1280,720&scl=1\" class=\"cmp-image__image\" alt=\"Flexis transportation\" loading=\"lazy\" itemprop=\"contentUrl\"/>\n                \n                \n                \n            </div>\n        </div>\n        \n        <div class=\"cmp-teaser__overlay\"></div>\n        <div class=\"cmp-teaser__overlay--shade\"></div>\n        \n        <div class=\"cmp-teaser__content\">\n            <div class=\"article__header\">\n                \n                <div class=\"article__details direction--ltr\">\n                    \n                    \n                    <span class=\"article__time\">\n                        \n                        4 mins.\n                    </span>\n                    <sp