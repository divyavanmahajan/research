            "text": "\n<!DOCTYPE HTML>\n<html lang=\"en\">\n      <head>\n    <meta charset=\"UTF-8\"/>\n    <title>Strategy \u01c0 Volvo Group</title>\n    <meta name=\"keywords\" content=\"Strategy\"/>\n    <meta name=\"description\" content=\"Learn more about our Mission and Vision, our values and total offer.\"/>\n    \n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n\n    \n    \n    \n\n    \n\n    \n\n    \n\n    \n    \n<meta name=\"content-page-ref\" content=\"hd1O-OeWWOSI0ujk-dVjSFZHD7neXo7rcNVSYZrC0PiXdDza5QA0fF7qJD8GuZcKF68HpHI5OCm-KSJ6-FZbylCzNJqsY28udqv3rax5N8M\"/>\n<script defer=\"defer\" type=\"text/javascript\" src=\"/.rum/@adobe/helix-rum-js@%5E2/dist/micro.js\"></script>\n<link rel=\"stylesheet\" href=\"/clientlibs-edge/production/20260304104855/shared/vcdk/publish.css\" type=\"text/css\"><script src=\"/clientlibs-edge/production/20260304104855/shared/vcdk/publish.js\" defer></script>\n\n\n\n\n\n    \n    \n<script src=\"/clientlibs-edge/production/20260304104855/shared/vcdk/components.js\" defer></script>\n\n\n\n\n\n\n\n\n    <link rel=\"preconnect\" href=\"https://cdn.designsystem.volvogroup.com\"/>\n    <link rel=\"preconnect\" href=\"https://cdn.designsystem.volvogroup.com\" crossorigin/>\n    <link href=\"https://cdn.designsystem.volvogroup.com/2-2-0/css/volvo/typefaces.css\" rel=\"stylesheet\"/>\n\n\n\n    \n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/>\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin/>\n    <link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wdth,wght@0,62.5..100,100..900;1,62.5..100,100..900&display=swap\" rel=\"stylesheet\"/>\n\n    \n    \n\n\n\n\n\n\n\n\n\n    \n    <meta property=\"og:title\" content=\"Strategy\"/>\n<meta property=\"og:description\" content=\"Discover Volvo Group&#39;s strategic approach, vision, mission and much more...\"/>\n<meta property=\"og:type\" content=\"website\"/>\n<meta property=\"og:image\" co